# macOS
.DS_Store

# V-layer full-text pre-fetch (scripts/fetch_fulltexts_oa.py): publisher/PMC PDFs and the
# resumable fetch ledger are never committed; only the manifest/summary under
# 04_screening/formal_*/fulltext/ and fulltext_requests/fulltext_requests.csv are tracked.
/fulltexts/

# LaTeX build artefacts (regenerable from source via scripts/build_protocol.py)
*.aux
*.log
*.out
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
# Local TeX build output (compile.py --outdir build_v3). Not committed: the published PDF is
# 01_protocol/protocol_EN_typeset.pdf (hash in build_manifest.json); validate_design.py skips build checks when absent.
01_protocol/build_v3/
# Superseded local build directories (v1, v2); not used by any script
01_protocol/build/
01_protocol/build_v2/

# Excel/LibreOffice lock files created while a generated workbook is open
templates_xlsx/~$*.xlsx
templates_xlsx/.~lock.*#

# Python
__pycache__/
*.pyc

# Local tool configuration (not research content)
.claude/

# Local scratch / exports that must never be committed raw
# (database exports stay in 03_search/raw_exports/ only if licence permits; add explicit exceptions here)

# Browser-automation scratch created by AI tooling
.playwright-mcp/

# Pilot/search exports containing publisher abstracts: rebuildable from pool_pmids.txt via scripts/fetch_pilot_pool.py; not published (see scripts/README.md)
04_screening/pilot_*/pool_metadata.json.gz
04_screening/pilot_*/pilot_sample_*.csv
04_screening/pilot_*/*.xlsx

# Charting-pilot full texts and supplements (publisher/PMC copies; hashes in 05_extraction/pilot_2026-10-05/fulltexts_manifest.json)
05_extraction/pilot_2026-10-05/fulltexts/

# PRE-009 AI-assisted extraction pilot comparison (scripts/extract_pdf_text.py, extract_run.py,
# extract_pilot_eval.py): page-marked full text, raw per-family run JSON/manifests-in-progress,
# loader-adapter JSON and generated reviewer workbooks all carry full-text content or long raw
# model output and are never committed; only the model-neutral prompt, the generated strict
# schema, the committable run_manifest.json and the pilot_comparison_*.md report are tracked.
05_extraction/ai_extraction/text/
05_extraction/ai_extraction/runs/
05_extraction/ai_extraction/workbooks/
05_extraction/ai_extraction/ai_extraction_json/
05_extraction/ai_extraction/compare_*/

# Formal-search raw exports and metadata (PubMed/preprint abstracts, Scopus entries, and D's manual
# licensed-database exports named <DB>_<route>_<date>.ris/.txt per scripts/README.md "Formal search
# execution"): never committed, any route, any dated run folder. Only the specific, named,
# no-abstract committable files are un-ignored below (manifest/overlap JSON and small identifier-list
# .txt files written by scripts/run_formal_pubmed.py / run_formal_scopus.py / run_preprint_search.py) --
# NOT a blanket *.json/*.txt negation, because D's raw <DB>_<route>_<date>.txt exports live in the same
# folder and must stay ignored. Raw exports are always *.jsonl.gz, *.ris, or *.txt under that naming
# convention, so none of them match the explicit allow-list below.
03_search/formal_runs/*/*/*
!03_search/formal_runs/*/*/manifest.json
!03_search/formal_runs/*/*/run_manifest.json
!03_search/formal_runs/*/*/route_overlap.json
!03_search/formal_runs/*/*/*_eids.txt
!03_search/formal_runs/*/*/*_dois.txt
!03_search/formal_runs/*/*/*_pmids.txt

# Manual database exports by D (raw records with abstracts): never committed; manifests only
03_search/full_exports_*/*
!03_search/full_exports_*/*.json

# platform screenshots may show account names: never commit
03_search/search_checks_*/*.png
03_search/search_checks_*/*.jpg
!03_search/formal_runs/*/*/*_uts.txt

# formal dedup outputs that carry abstracts (copyright text): never commit
04_screening/formal_*/records_master.csv
04_screening/formal_*/*abstract*

# Stage-2 reviewer workbooks contain publisher abstracts (like records_master): never commit
04_screening/formal_*/ai_stage2/*.xlsx
# Pre-fill backup copies of the same workbooks (scripts/ta_ai_merge.py regenerates the
# originals; backups are a safety net only, contain abstracts, never commit)
04_screening/formal_*/ai_stage2/_backup_prefill_*/
# Provisional self-test/dry-run outputs of scripts/ta_human_merge.py (run before reviewers
# have actually overridden the pre-fill; labelled provisional in the filename)
04_screening/formal_*/ai_stage2/*_provisional*

