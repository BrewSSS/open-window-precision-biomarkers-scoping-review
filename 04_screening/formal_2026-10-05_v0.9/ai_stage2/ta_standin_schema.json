{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "record_id",
  "disposition",
  "primary_code",
  "secondary_codes",
  "study_type_hint",
  "note"
 ],
 "properties": {
  "record_id": {
   "type": "string"
  },
  "disposition": {
   "type": "string",
   "enum": [
    "ADVANCE",
    "EXCLUDE_TA",
    "AWAITING_CLASSIFICATION"
   ]
  },
  "primary_code": {
   "type": "string",
   "enum": [
    "",
    "FT01",
    "FT02",
    "FT03",
    "FT04",
    "FT05",
    "FT06",
    "FT07",
    "FT08"
   ]
  },
  "secondary_codes": {
   "type": "array",
   "items": {
    "type": "string",
    "enum": [
     "FT01",
     "FT02",
     "FT03",
     "FT04",
     "FT05",
     "FT06",
     "FT07",
     "FT08"
    ]
   }
  },
  "study_type_hint": {
   "type": "string",
   "enum": [
    "acute_bout_CoreA",
    "repeated_bouts_SupportB",
    "chronic_training_only",
    "cross_sectional_resting",
    "other"
   ]
  },
  "note": {
   "type": "string",
   "maxLength": 200
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "disposition": {
      "const": "EXCLUDE_TA"
     }
    }
   },
   "then": {
    "properties": {
     "primary_code": {
      "enum": [
       "FT01",
       "FT02",
       "FT03",
       "FT04",
       "FT05",
       "FT06",
       "FT07",
       "FT08"
      ]
     }
    }
   },
   "else": {
    "properties": {
     "primary_code": {
      "const": ""
     }
    }
   }
  }
 ]
}
